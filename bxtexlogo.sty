\bxlg@checkdefinable
\DeclareRobustCommand*\bxtexlogoTest{%
  \par \let\do\bxlg@logo@test@do \bxlg@list}
\def\bxlg@logo@test@do#1{%
  \texttt{#1}:\quad\@nameuse{bxlg@logo@@#1}\par}

